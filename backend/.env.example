# ---------------------------------------------------------------------------
# አዲስ ማዕድ (Addis Maed) — API environment
# Copy to server/.env and fill in values. Never commit the real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgresql://communityhub:communityhub@localhost:5433/communityhub?schema=public

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN_DAYS=7

# Public origin of the web app and extra allowed CORS origins (comma separated)
CLIENT_ORIGIN=http://localhost:5173
CORS_EXTRA_ORIGINS=

# Public base URL used to build absolute media links (leave empty for same-origin/relative URLs)
PUBLIC_API_URL=
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# How often the event importer re-reads its online sources (minutes; 0 disables).
EVENTS_SYNC_MINUTES=180

# Gemini keys used by the event extractor, comma separated. The pool rotates to
# the next key when one reports its quota as exhausted; leave empty to let the
# importer fall back to its regex parsers.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash

# Web Push. Leave the key pair empty to let the API generate one on first use
# and keep it in the database; set both only to manage keys externally.
VAPID_SUBJECT=mailto:admin@communityhub.et
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# SMS delivery for phone verification and password reset.
# console  -> codes are written to the server log (development only)
# knock    -> Knock workflow trigger (requires KNOCK_API_KEY + KNOCK_SMS_WORKFLOW)
# twilio   -> Twilio Programmable Messaging
SMS_PROVIDER=console
SMS_FROM=CommunityHub
KNOCK_API_KEY=
KNOCK_SMS_WORKFLOW=phone-verification
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
