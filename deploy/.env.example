# Server-side environment for the VPS stack (deploy/docker-compose.prod.yml).
# Copy to `.env` next to the compose file on the server. The deploy pipeline
# creates it from this file on the first run and fills the secrets below.
# Never commit the real `.env`.

# --- Public entry point -----------------------------------------------------
# Hostname whose DNS A/AAAA record points at this VPS. Caddy obtains the
# certificate on first start. Empty DOMAIN runs the stack over plain HTTP on
# WEB_PORT and the deploy scripts clear COOKIE_SECURE, because a browser drops
# Secure cookies over HTTP and every action would look signed out.
DOMAIN=

# Direct HTTP port for the web container (loopback when Caddy is enabled).
WEB_PORT=8080
WEB_BIND=127.0.0.1

# Set to 1 when HTTPS is terminated by something other than the compose Caddy
# (the host's own nginx, see https-setup.sh): keeps the web container on
# loopback and keeps the session cookie Secure instead of downgrading it for
# plain HTTP.
BEHIND_TLS_PROXY=

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=communityhub
POSTGRES_DB=communityhub
# Generated on the first deploy when empty.
POSTGRES_PASSWORD=
DATABASE_URL=

# --- Auth -------------------------------------------------------------------
# Generated on the first deploy when empty (48 random bytes, hex).
JWT_SECRET=
JWT_EXPIRES_IN_DAYS=7
# Empty follows NODE_ENV (on in production). The no-domain path in deploy.sh
# and update.sh turns it off because there is no TLS to carry the cookie yet.
COOKIE_SECURE=

# Origin allowed to call the API, e.g. https://addisweg.et
# Filled from DOMAIN on the first deploy when empty.
CLIENT_ORIGIN=
CORS_EXTRA_ORIGINS=

# Leave empty to keep media URLs same-origin (served through the web container).
PUBLIC_API_URL=
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# --- Event import -----------------------------------------------------------
EVENTS_SYNC_MINUTES=180
# Comma-separated Gemini keys for the AI extractor; empty falls back to regex.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash

# --- SMS (phone verification, password reset) -------------------------------
# console writes codes to the server log. Production needs knock or twilio.
SMS_PROVIDER=console
SMS_FROM=CommunityHub
KNOCK_API_KEY=
KNOCK_SMS_WORKFLOW=phone-verification
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
